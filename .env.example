# ====================================================
# Q-SHIELD SECURITY PLATFORM — ENVIRONMENT CONFIGURATION
# ====================================================
# Copy this file to .env for local overrides or configure in Render / Vercel dashboard.
# NEVER commit real production secrets to version control.

# ----------------------------------------------------
# BACKEND CONFIGURATION (Render / Local)
# ----------------------------------------------------
# Database: SQLite for local dev, PostgreSQL for production
DATABASE_URL=sqlite:///./database/qshield.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql://qshield_user:password@hostname:5432/qshield_db

# Cryptographic Keys & JWT Secret (Generate random 64-char hex string in production)
SECRET_KEY=change-this-to-a-secure-random-64-character-hex-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Network & Runtime
PORT=8000
ENVIRONMENT=development

# Allowed CORS Origins (Comma-separated list of allowed frontend origins)
# In production, set to your Vercel domain:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://quantam-shield.vercel.app

# Storage Directories (Optional custom path for persistent volume mounts)
# UPLOADS_DIR=./uploads
# REPORTS_DIR=./reports

# ----------------------------------------------------
# FRONTEND CONFIGURATION (Vercel / Local)
# ----------------------------------------------------
# Backend API Base URL
# Local development: leave unset or set to http://localhost:8000
# Production (Vercel): set to your deployed Render URL (e.g. https://qshield-backend.onrender.com)
VITE_API_URL=http://localhost:8000
