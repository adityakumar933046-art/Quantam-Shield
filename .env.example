# Q-SHIELD Environment Configuration Example
# Copy this file to .env and configure values for your deployment

# Database Configuration
DATABASE_URL=sqlite:///./database/qshield.db
# For PostgreSQL in production:
# DATABASE_URL=postgresql://qshield_user:qshield_password@localhost:5432/qshield_db

# Cryptographic Keys & JWT Configuration
SECRET_KEY=change-this-to-a-secure-random-64-character-hex-string
FERNET_KEY=change-this-to-a-valid-base64-32-byte-fernet-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Storage Locations
MEDIA_ROOT=./uploads
REPORTS_DIR=./uploads/reports

# Security Engine Parameters
REPLAY_WINDOW_MINUTES=10
REPLAY_THRESHOLD_COUNT=6

# Network / Ports
BACKEND_PORT=8000
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000/api
